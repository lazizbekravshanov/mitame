{
  "name": "@lazizbekio/mitame",
  "version": "0.1.1",
  "description": "Copy-paste React components that bring old UI back to life, from 1984 Mac to 2026 liquid glass.",
  "keywords": [
    "react",
    "components",
    "ui",
    "copy-paste",
    "liquid-glass",
    "retro",
    "nostalgia",
    "tailwind",
    "design-system",
    "cli"
  ],
  "license": "MIT",
  "author": "Lazizbek Ravshanov",
  "homepage": "https://github.com/lazizbekravshanov/mitame#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazizbekravshanov/mitame.git"
  },
  "bugs": {
    "url": "https://github.com/lazizbekravshanov/mitame/issues"
  },
  "type": "module",
  "bin": {
    "mitame": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.cli.json",
    "tokens": "node scripts/build-tokens.ts",
    "icons": "node scripts/build-icons.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "site:dev": "astro dev --root site",
    "site:build": "astro build --root site",
    "site:preview": "astro preview --root site",
    "social": "npm run site:build && node scripts/build-social.mjs",
    "clip": "npm run site:build && node scripts/record-eras.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "astro": "^7.3.3",
    "gifenc": "^1.0.3",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "upng-js": "^2.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
