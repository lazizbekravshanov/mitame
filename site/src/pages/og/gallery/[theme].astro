---
import ShotGallery from "../../../components/shots/ShotGallery";
import "../../../styles/site.css";
import "../_shot.css";

export function getStaticPaths() {
  return ["aqua", "liquid", "platinum", "system", "aero", "brutalist", "minimal", "urban", "paper", "terminal", "neon"].map((theme) => ({ params: { theme } }));
}
const { theme } = Astro.params;
---

<html lang="en" data-theme={theme} data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>mitame gallery shot</title>
  </head>
  <body style="margin:0">
    <ShotGallery theme={theme!} />
  </body>
</html>
