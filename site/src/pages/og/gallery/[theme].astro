---
import ShotGallery from "../../../components/shots/ShotGallery";
import { THEMES } from "../../../lib/theme";
import "../../../styles/site.css";
import "../_shot.css";

// Every theme gets a shot page, so the social script can photograph all of them.
export function getStaticPaths() {
  return THEMES.map((t) => ({ params: { theme: t.id } }));
}
const { theme } = Astro.params;
---

<html lang="en" data-theme={theme} data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>mitame gallery shot</title>
  </head>
  <body style="margin:0">
    <ShotGallery theme={theme!} />
  </body>
</html>
