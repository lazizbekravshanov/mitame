---
import Base from "../layouts/Base.astro";

const eras = [
  {
    id: "aqua",
    era: "Y2K",
    years: "2000 to 2012",
    status: "Available · default",
    text: "Lickable gel buttons, pinstripes, the blue ⇅ popup button, yellow help tags and smoky notifications. Midnight dark mode included.",
  },
  {
    id: "liquid",
    era: "Now",
    years: "2025 and later",
    status: "Available",
    text: "Frosted liquid glass with a bright rim light, deep soft shadows and one Aqua style shine on the primary button.",
  },
  {
    id: "platinum",
    era: "Vintage",
    years: "1984 to 1999",
    status: "Available",
    text: "Mac OS 8 and 9 Platinum: flat gray, 1px black outlines, raised and sunken bevels, hard drop shadows, square corners and no animation. Dark mode is graphite.",
  },
  {
    id: "blend",
    era: "Remix",
    years: "any",
    status: "Planned",
    text: "Old structure on new material: Platinum lines on liquid glass.",
  },
];
---

<Base title="Themes" description="mitame eras: Y2K Aqua, Now liquid glass, and Vintage and Remix coming soon. One set of React components, many looks.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="m-0 text-4xl font-bold tracking-tight">Themes</h1>
    <p class="lede mt-3 max-w-2xl">Every component works in every era. A theme is one CSS file keyed by <code class="inline-code">data-theme</code>; tokens are designed in Figma.</p>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        eras.map((e) => (
          <div data-theme={["aqua", "liquid", "platinum"].includes(e.id) ? e.id : undefined} class="rounded-mi-lg overflow-hidden">
            <div class="wallpaper p-5">
              <div class="panel p-6">
                <p class="m-0 text-sm font-semibold text-mi-fg-muted">
                  {e.era} · {e.years}
                </p>
                <h2 class="mt-1 mb-2 text-2xl font-bold">{e.id}</h2>
                <p class="m-0 text-mi-fg-muted">{e.text}</p>
                <p class="mt-4 mb-0 text-sm font-semibold">{e.status}</p>
                {["aqua", "liquid", "platinum"].includes(e.id) && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    <span class="mi-button" data-slot="button" data-variant="primary" data-size="sm">Primary</span>
                    <span class="mi-button" data-slot="button" data-variant="secondary" data-size="sm">Secondary</span>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Base>
