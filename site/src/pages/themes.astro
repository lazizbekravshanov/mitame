---
import Base from "../layouts/Base.astro";

const shelves = [
  {
    name: "Eras",
    blurb: "Looks that actually existed, rebuilt from memory and screenshots.",
    themes: [
      { id: "platinum", title: "Vintage · 1997", live: true, text: "Mac OS 8 and 9 Platinum: flat gray, 1px black outlines, raised and sunken bevels, hard drop shadows, square corners and no animation. Dark mode is graphite." },
      { id: "aqua", title: "Y2K · 2000 to 2012", live: true, text: "Lickable gel buttons, pinstripes, the blue ⇅ popup button, yellow help tags and smoky notifications. Midnight dark mode included." },
      { id: "liquid", title: "Now · 2025 and later", live: true, text: "Frosted liquid glass with a bright rim light, deep soft shadows and one Aqua style shine on the primary button." },
      { id: "system", title: "Vintage · 1984", live: true, text: "The original Macintosh: 1-bit black and white, no gray anywhere. Depth comes from dither patterns, selection inverts, nothing animates." },
      { id: "aero", title: "Y2K · 2006 to 2012", live: true, text: "Frutiger Aero: glossy glass, saturated sky blues, wet highlights on every control. Vista and Windows 7 by way of a stock photo." },
    ],
  },
  {
    name: "Styles",
    blurb: "Looks that are just looks. No nostalgia required.",
    themes: [
      { id: "brutalist", title: "Loud", live: true, text: "Thick black outlines, hard offset shadows, zero radius and flat color. Press a button and it slams into its own shadow." },
      { id: "minimal", title: "Quiet", live: true, text: "Swiss: hairline borders, no shadows, generous space and one ink color doing all the work. Tabs are an underline, inputs are a rule." },
      { id: "urban", title: "Night", live: true, text: "Streetwear: near black with a scanline grain, acid green accent, heavy uppercase type and monospace sticker tags." },
      { id: "paper", title: "Printed", live: true, text: "Warm off-white stock, serif headings over a quiet sans, clay accent and ink hairlines. The look of a well set document." },
      { id: "terminal", title: "Phosphor", live: true, text: "Monospace everything, bracketed buttons, inverted selection, scanlines and a blinking caret. Light mode is amber on paper." },
      { id: "neon", title: "City", live: true, text: "Deep violet black with magenta and cyan glow, blurred halos and lit controls. The switch actually glows when it is on." },
      { id: "sumi", title: "Ink", live: true, text: "Japanese spatial minimalism: a space scale with a hole in it, so every gap is either hairline fine or room sized. Cut square corners, traditional colours, and one vermilion seal per component." },
    ],
  },
];
---

<Base image="/social/og-platinum.png" title="Themes" description="mitame themes: Vintage platinum, Y2K aqua, Now liquid glass, plus brutalist, minimal and urban styles. One set of React components, many looks.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="m-0 text-4xl font-bold tracking-tight">Themes</h1>
    <p class="lede mt-3 max-w-2xl">
      Every component works in every theme. A theme is one CSS file keyed by <code class="inline-code">data-theme</code>, and the tokens behind it are designed in Figma.
    </p>

    {
      shelves.map((shelf) => (
        <div class="mt-12">
          <h2 class="m-0 text-2xl font-bold">{shelf.name}</h2>
          <p class="mt-1 mb-6 text-mi-fg-muted">{shelf.blurb}</p>
          <div class="grid gap-5 md:grid-cols-2">
            {shelf.themes.map((t) => (
              <div data-theme={t.live ? t.id : undefined} class="rounded-mi-lg overflow-hidden">
                <div class="wallpaper p-5">
                  <div class="panel p-6">
                    <p class="m-0 text-sm font-semibold text-mi-fg-muted">{t.title}</p>
                    <h3 class="mt-1 mb-2 text-2xl font-bold">{t.id}</h3>
                    <p class="m-0 text-mi-fg-muted">{t.text}</p>
                    <p class="mt-4 mb-0 text-sm font-semibold">{t.live ? "Available" : "Coming next"}</p>
                    {t.live && (
                      <div class="mt-4 flex flex-wrap items-center gap-2">
                        <span class="mi-button" data-slot="button" data-variant="primary" data-size="sm">Primary</span>
                        <span class="mi-button" data-slot="button" data-variant="secondary" data-size="sm">Secondary</span>
                        <code class="inline-code">data-theme="{t.id}"</code>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</Base>
