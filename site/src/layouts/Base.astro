---
import ThemeSwitcher from "../components/ThemeSwitcher";
import { THEMES } from "../lib/theme";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** Social preview, relative to the site root. Defaults to the Aqua card. */
  image?: string;
  wide?: boolean;
}
const { title, description, image = "/social/og.png" } = Astro.props;
const fullTitle = title === "mitame" ? "mitame 見た目 · old UI, brought back to life" : `${title} · mitame`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
const path = Astro.url.pathname;
// The pre-paint script validates against this, so a new theme cannot be left out.
const themeIds = JSON.stringify(THEMES.map((t) => t.id));
const nav = [
  { href: "/docs", label: "Docs" },
  { href: "/docs/components", label: "Components", match: "/docs/components" },
  { href: "/blocks", label: "Blocks" },
  { href: "/themes", label: "Themes" },
];
---

<!doctype html>
<html lang="en" data-theme="aqua">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="mitame 見た目: a Preferences card rendered in the 2001 Aqua theme, next to the wordmark and the command npx @lazizbekio/mitame add button." />
    <meta property="og:site_name" content="mitame" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Inter:wght@300..700&family=JetBrains+Mono:wght@400;700&family=Newsreader:opsz,wght@6..72,300;6..72,400&display=swap" />
    <script is:inline define:vars={{ themeIds }}>
      // Apply the saved era and mode before first paint (no flash).
      try {
        const t = localStorage.getItem("mitame-theme");
        const m = localStorage.getItem("mitame-mode");
        if (themeIds.includes(t)) document.documentElement.dataset.theme = t;
        if (m === "light" || m === "dark") document.documentElement.dataset.mode = m;
      } catch {}
    </script>
  </head>
  <body class="wallpaper text-mi-fg">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50">Skip to content</a>
    <header class="site-header sticky top-0 z-40">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3">
        <div class="flex items-center gap-4 sm:gap-6">
          <a href="/" class="text-xl font-bold tracking-tight text-mi-fg no-underline">mitame</a>
          <nav aria-label="Main" class="flex items-center gap-4 sm:gap-5">
            {
              nav.map((n) => (
                <a
                  href={n.href}
                  class="nav-link"
                  aria-current={path.startsWith(n.match ?? n.href) && !(n.href === "/docs" && path.startsWith("/docs/components")) ? "page" : undefined}
                >
                  {n.label}
                </a>
              ))
            }
            <a href="https://github.com/lazizbekravshanov/mitame" class="nav-link hidden sm:inline">GitHub</a>
          </nav>
        </div>
        <ThemeSwitcher client:load />
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl px-4 py-12 text-sm text-mi-fg-muted">
      <p class="m-0">
        mitame is MIT licensed. Built with mitame, on the web platform. <a class="link" href="https://github.com/lazizbekravshanov/mitame">Source on GitHub</a>.
      </p>
    </footer>
  </body>
</html>
