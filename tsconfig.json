{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@mitame/*": [
        "./registry/*"
      ]
    }
  },
  "include": [
    "registry",
    "cli",
    "scripts",
    "tests",
    "playground",
    "vite.config.ts",
    "site/src/**/*.ts",
    "site/src/**/*.tsx"
  ],
  "exclude": [
    "scripts/figma"
  ]
}
